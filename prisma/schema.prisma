generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres: necesario para desplegar en Vercel (u otro entorno serverless),
  // donde el sistema de archivos es efímero/de solo lectura y no admite un
  // archivo de SQLite. Usar un Postgres gratuito (Neon, Supabase, Vercel
  // Postgres) tanto en desarrollo local como en producción.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Nota: los "enums" de este esquema (Role, PropertyType, OperationType,
// PropertyStatus) se modelan como String en vez de `enum` de Prisma para
// no perder la posibilidad de volver a SQLite en desarrollo local sin
// dependencias. Se validan en la app (ver src/lib/constants.ts).

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("AGENTE") // "ADMIN" | "AGENTE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
}

model Property {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String // "CASA" | "DEPARTAMENTO" | "PH" | "TERRENO" | "LOCAL" | "OFICINA"
  operation     String // "VENTA" | "ALQUILER"
  status        String   @default("DISPONIBLE") // "DISPONIBLE" | "RESERVADA" | "VENDIDA" | "ALQUILADA"
  price         Float
  currency      String   @default("USD")
  address       String
  city          String
  province      String
  bedrooms      Int      @default(0)
  bathrooms     Int      @default(0)
  areaTotal     Float    @default(0)
  areaCovered   Float    @default(0)
  images        String   @default("[]") // JSON array de URLs
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  inquiries Inquiry[]

  // Índices pensados para gran volumen de propiedades: filtros y orden
  // por fecha son las consultas más frecuentes del listado público.
  @@index([city])
  @@index([type])
  @@index([operation])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([ownerId])
}

model Inquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String
  createdAt  DateTime @default(now())

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([createdAt])
}
