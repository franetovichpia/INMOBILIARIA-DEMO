# Base de datos Postgres (necesaria para desplegar en Vercel).
# Conseguí una gratis en https://neon.new (o Supabase / Vercel Postgres) y
# pegá acá la connection string que te den.
DATABASE_URL="postgresql://usuario:password@host/nombre_db?sslmode=require"

# NextAuth
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Clave de la API de Anthropic para el chat con IA (opcional en desarrollo:
# sin ella, el chat responde con búsquedas básicas sobre las propiedades)
ANTHROPIC_API_KEY=""

# Nombre del agente que muestra el chat al derivar una consulta
AGENT_NAME="Gastón Niggli"

# Número de WhatsApp del agente en formato internacional sin "+" ni espacios
# (ej. 5492254000000). Si se deja vacío, el chat deriva la consulta al panel
# de gestión igual, pero sin ofrecer el link directo de WhatsApp.
AGENT_WHATSAPP=""
